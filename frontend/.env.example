# Skopiuj do .env (lokalnie) — NIE commituj prawdziwego .env

# --- Dev (telefon w LAN / emulator) ---
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000
# Emulator Android: http://10.0.2.2:3000

# --- Production / EAS build (WYMAGANE przed Internal testing) ---
# Ustaw jako EAS Secret / Environment variable dla profilu "production":
# EXPO_PUBLIC_API_URL=https://twoje-api.example.com

EXPO_PUBLIC_API_URL=

# Google Sign-In (patrz: npm run google:setup)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Expo / EAS (opcjonalnie — jest też fallback w app.config.ts)
# EXPO_PUBLIC_EAS_PROJECT_ID=

# Dev only — nie ustawiaj w production
# EXPO_PUBLIC_DEV_SENIOR_PREVIEW=true
