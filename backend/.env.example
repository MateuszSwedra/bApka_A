# Skopiuj do .env — NIE commituj prawdziwego .env

DATABASE_URL=
JWT_SECRET=
# Token lifetime (default 7d). Prefer short TTL in production.
JWT_EXPIRES_IN=7d

# Production (Render): origins przeglądarki, przecinkami.
# Bez tego / przy pustym — API i tak puszcza typowe Expo web (localhost:8081).
# CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,https://twoja-domena.example

# Strefa harmonogramów leków (HH:mm) — domyślnie Europe/Warsaw
APP_TIMEZONE=Europe/Warsaw

# Te same wartości co EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (weryfikacja id_token)
GOOGLE_CLIENT_ID=

# Firebase Admin (SOS) — plik *-firebase-adminsdk*.json jako:
# backend/firebase-service-account.json  (NIE commituj)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Alternatywa lokalna (jedna linia JSON): FIREBASE_SERVICE_ACCOUNT_JSON=
